# This .gitignore file should be placed at the root of your repository (above UnityProject/)
#
UnityProject/.utmp/
UnityProject/[Ll]ibrary/
UnityProject/[Tt]emp/
UnityProject/[Oo]bj/
UnityProject/[Bb]uild/
UnityProject/[Bb]uilds/
UnityProject/[Ll]ogs/
UnityProject/[Uu]ser[Ss]ettings/
UnityProject/*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
UnityProject/[Mm]emoryCaptures/

# Recordings can get excessive in size
UnityProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# UnityProject/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
UnityProject/.vs/

# Gradle cache directory
UnityProject/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
UnityProject/ExportedObj/
UnityProject/.consulo/
UnityProject/*.csproj
UnityProject/*.unityproj
UnityProject/*.sln
UnityProject/*.suo
UnityProject/*.tmp
UnityProject/*.user
UnityProject/*.userprefs
UnityProject/*.pidb
UnityProject/*.booproj
UnityProject/*.svd
UnityProject/*.pdb
UnityProject/*.mdb
UnityProject/*.opendb
UnityProject/*.VC.db

# Unity3D generated meta files
UnityProject/*.pidb.meta
UnityProject/*.pdb.meta
UnityProject/*.mdb.meta

# Unity3D generated file on crash reports
UnityProject/sysinfo.txt

# Builds
UnityProject/*.apk
UnityProject/*.aab
UnityProject/*.unitypackage
UnityProject/*.unitypackage.meta
UnityProject/*.app

# Crashlytics generated file
UnityProject/crashlytics-build.properties

# Packed Addressables
UnityProject/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
UnityProject/[Aa]ssets/[Ss]treamingAssets/aa.meta
UnityProject/[Aa]ssets/[Ss]treamingAssets/aa/*

# Virtual environment folder (anywhere in the repo or inside the project)
python-backend/*.venv/